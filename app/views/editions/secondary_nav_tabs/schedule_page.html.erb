<% @edition = @resource %>
<% title = "Schedule publication" %>
<% content_for :title_context, @edition.title %>
<% content_for :page_title, title %>
<% content_for :title, title %>

<%= render "editions/secondary_nav_tabs/progress_with_comment", {
  form_url: schedule_edition_path(@edition),
  comment_label_text: "Comment (optional)",
  submit_button_text: "Schedule",
  title:,
  schedule_fields: (render "govuk_publishing_components/components/datetime_fields", {
    heading_size: "m",
    date_heading: "Publication date",
    time_heading: "Publication time",
    date_hint: "For example, #{(Time.zone.now + 3.months).strftime("%-d %-m %Y")}",
    year: {
      name: "publish_at_1i",
    },
    month: {
      name: "publish_at_2i",
    },
    day: {
      name: "publish_at_3i",
    },
    hour: {
      name: "publish_at_4i",
      value: 0
    },
    minute: {
      name: "publish_at_5i",
      value: 1
    }
  })
} %>
