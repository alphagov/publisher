<% content_for :page_title, "2i queue" %>
<% content_for :title, "2i queue" %>

<div class="govuk-grid-row">
  <div
    class="govuk-grid-column-full two-eye-queue"
    data-module="ga4-link-tracker"
    data-ga4-link='{ "event_name": "navigation", "type": "generic_link" }'
    data-ga4-limit-to-element-class="govuk-link"
  >
		<%= render "govuk_publishing_components/components/inset_text", {
			text:safe_join([link_to(
				"Check collections publisher (opens in new tab)",
				"#{Plek.find('collections-publisher', external: true)}/step-by-step-pages?title_or_url=&status=submitted_for_2i",
				target: "_blank",
				rel: "noopener",
				class: "govuk-link govuk-link--no-visited-state",
				),
			 " for step by steps waiting for 2i."]),
		} %>

		<%= render "govuk_publishing_components/components/tabs", {
      panel_border: false,
			tabs: [
				 {
 					id: "english",
 					label: "English",
 					content: render(partial: "two_eye_queue_table", locals: { editions: @english_editions, language: "english"}),
          tab_data_attributes: {
            "ga4-event": {
              event_name: "select_content",
              type: "tabs",
              index_section: 1,
              index_section_count: 2,
            },
          },
 				},
				{
					id: "welsh",
					label: "Welsh",
					content: render(partial: "two_eye_queue_table", locals: { editions: @welsh_editions, language: "welsh"}),
          tab_data_attributes: {
            "ga4-event": {
              event_name: "select_content",
              type: "tabs",
              index_section: 2,
              index_section_count: 2,
            },
          },
				},
			],
		} %>
  </div>
</div>
