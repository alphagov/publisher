<%# component_helper = GovukPublishingComponents::Presenters::ComponentWrapperHelper.new(local_assigns) %>

<%= form_with url: find_content_path, method: :get, data: { ga4_search_type: "index_additions", ga4_search_section: "Find content", ga4_search_url: find_content_path, ga4_section: "Find content" } do %>
  <div class="govuk-grid-row find-content">
    <div class="govuk-grid-column-one-quarter">
      <%= render "govuk_publishing_components/components/input", {
        label: {
          text: "Title or slug",
          heading_size: "m",
        },
        name: "search_text",
        value: @presenter.search_text,
        type: "search",
      } %>
    </div>

    <div class="govuk-grid-column-one-quarter">
      <%= render "govuk_publishing_components/components/select_with_search", {
        id: "states_filter",
        label: "Status",
        heading_size: "m",
        full_width: true,
        options: @presenter.state_options,
      } %>
    </div>

    <div class="govuk-grid-column-one-quarter js-ga4-redact-names">
      <%# component_helper.add_data_attribute({ "ga4-redact": true }) %>

      <%# tag.div(**component_helper.all_attributes) do %>
        <%# render "govuk_publishing_components/components/fieldset", {
          legend_text: "Do you have a passport?"
        } do %>
        <!-- The fieldset element should include all the filters really
        When this is working make that change
        But then the redaction will need to be removed from all the other filters -->
        <fieldset>
          <%= render "govuk_publishing_components/components/select_with_search", {
            id: "assignee_filter",
            label: "Assigned to",
            heading_size: "m",
            options: @presenter.assignee_options,
          } %>
        </fieldset>
        <%# end %>
      <%# end %>
    </div>

    <div class="govuk-grid-column-one-quarter">
      <%= render "govuk_publishing_components/components/select_with_search", {
        id: "content_type_filter",
        label: "Content type",
        full_width: true,
        heading_size: "m",
        options: @presenter.content_type_options,
      } %>
    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <div class="govuk-button-group">
        <%= render "govuk_publishing_components/components/button", {
          text: "Apply filters",
        } %>

        <% if show_clear_filters_link? %>
          <%= link_to "Clear filters", find_content_path, class: "govuk-link govuk-link--no-visited-state", data: { "ga4-link": { action: "remove", event_name: "select_content", type: "publications" } } %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
